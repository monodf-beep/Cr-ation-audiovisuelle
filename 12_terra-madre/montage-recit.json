 "passages": [
  {
   "sequence": "sagre",
   "texte": "Les sagre, ce sont des endroits dans les villages en général pour célébrer la gastronomie,"
  },
  {
   "sequence": "sagre",
   "texte": "les produits du terroir, les produits du Piémont."
  },
  {
   "sequence": "gouter",
   "texte": "Ce que j'aime par-dessus tout, c'est"
  },
  {
   "sequence": "gouter",
   "texte": "de trouver des nouveaux produits et surtout de goûter, c'est ça l'important."
  },
  {
   "sequence": "piemont",
   "texte": "On y mange uniquement du territoire, donc en général dans le Piémont on y mange uniquement piémontais,"
  },
  {
   "sequence": "piemont",
   "texte": "on y mange beaucoup, on y mange très bien,"
  },
  {
   "sequence": "sieste",
   "texte": "moi je suis quelqu'un qui fait des siestes."
  },
  {
   "sequence": "turin",
   "texte": "Le week-end dernier j'étais à Turin pour Terra Madre,"
  },
  {
   "sequence": "turin",
   "texte": "pour valoriser le terroir piémontais,"
  },
  {
   "sequence": "viaroma",
   "texte": "surtout que c'était dans via Roma, ils ont refait toute la rue de via Roma."
  },
  {
   "sequence": "vallees",
   "texte": "Et ce week-end,"
  },
  {
   "sequence": "vallees",
   "texte": "dans le Piémont on a des vallées savoyardes bien sûr, on a des vallées occitanes,"
  },
  {
   "sequence": "vallees",
   "texte": "et là j'étais dans une vallée occitane."
  },
  {
   "sequence": "giaveno",
   "texte": "J'étais à Giaveno,"
  },
  {
   "sequence": "giaveno",
   "texte": "c'est un petit village,"
  },
  {
   "sequence": "giaveno",
   "texte": "et là il y avait justement la Sagra dei Funghi, donc pour les champignons."
  },
  {
   "sequence": "plats",
   "texte": "La lasagne avec les champignons, il y avait la salsiccia, la saucisse, c'était exceptionnel."
  },
  {
   "sequence": "influenceur",
   "texte": "Moi je vais pas vous montrer des plats, je suis pas un influenceur food, pas encore. Donc faut juste me faire confiance, et me croire."
  },
  {
   "sequence": "cumiana",
   "texte": "Et là je me trouve à Cumiana, entre Giaveno et Pinerolo."
  },
  {
   "sequence": "bulbe",
   "texte": "J'adore ce clocher, le bulbe,"
  },
  {
   "sequence": "bulbe",
   "texte": "qu'on retrouve un peu plus dans le Piémont, pas trop en Savoie,"
  },
  {
   "sequence": "bulbe",
   "texte": "mais c'est la même famille, on va dire."
  },
  {
   "sequence": "francois",
   "texte": "On retrouve beaucoup saint François de Sales,"
  },
  {
   "sequence": "francois",
   "texte": "c'est le saint patron des journalistes,"
  },
  {
   "sequence": "francois",
   "texte": "mais là, non, on ne l'a pas trouvé."
  },
  {
   "sequence": "baroque",
   "texte": "Et surtout le baroque : les églises regorgent de l'art baroque."
  },
  {
   "sequence": "fin",
   "texte": "Je vous remercie et à tout bientôt. Allez, abastou, ciao ciao."
  }
 ],
